    <style>
:root {
    --bg-color: #0f1115;
    --text-color: #f1f5f9;
    --text-muted: #cbd5e1;
    --accent-color: #3b82f6;
    --accent-hover: #2563eb;
    --card-bg: rgba(30, 41, 59, 0.6);
    --card-hover: rgba(30, 41, 59, 0.9);
    --border-color: rgba(255, 255, 255, 0.1);
    --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.6;
    min-height: 100vh;
}

body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-image: radial-gradient(circle at 50% -20%, #1e3a8a 0%, transparent 60%);
    z-index: -1;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
}

header {
    text-align: center;
    margin-bottom: 3rem;
}

h1 {
    font-size: 3rem;
    font-weight: 700;
    background: linear-gradient(to right, #60a5fa, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
}

header p {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 2rem;
}

.search-container {
    display: flex;
    justify-content: center;
    gap: 1rem;
    max-width: 600px;
    margin: 0 auto 1.5rem;
}

input[type="text"] {
    flex: 1;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    border: 1px solid var(--border-color);
    background: rgba(15, 23, 42, 0.6);
    color: white;
    font-size: 1rem;
    outline: none;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
}

input[type="text"]:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.3);
}

button {
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    border: none;
    background: #2563eb;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
}

button:hover {
    background: #1d4ed8;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
}

.api-config {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
}

.api-config input {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.85rem;
    max-width: 200px;
}

.hidden {
    display: none !important;
}

#loading {
    text-align: center;
    font-size: 1.2rem;
    color: var(--text-muted);
    margin: 2rem 0;
}

.error-msg {
    text-align: center;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 1rem;
    border-radius: 8px;
    margin: 1rem auto;
    max-width: 600px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
}

.card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: var(--glass-shadow);
    display: flex;
    flex-direction: column;
    cursor: pointer;
    will-change: transform;
}

.card:hover {
    transform: translateY(-5px);
    background: var(--card-hover);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
}

.card-img-container {
    width: 100%;
    aspect-ratio: 1;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
}

.card-img-container img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s ease;
    will-change: transform;
}

.card:hover .card-img-container img {
    transform: scale(1.05);
}

.placeholder {
    color: var(--text-muted);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
}

.card-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.card-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    word-break: break-all;
}

.badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    margin-top: 0.5rem;
}

.badge-download {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    margin-top: 0.5rem;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s;
    z-index: 10;
}

.badge-download:hover {
    background: rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
}

.badge-delete {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    background: rgba(239, 68, 68, 0.2);
    color: #f87171;
    margin-top: 0.5rem;
    margin-left: 0.5rem;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 10;
}

.badge-delete:hover {
    background: rgba(239, 68, 68, 0.4);
    color: #fca5a5;
}

.badge-rename {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
    margin-top: 0.5rem;
    margin-left: 0.5rem;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 10;
}

.badge-rename:hover {
    background: rgba(245, 158, 11, 0.4);
    color: #fcd34d;
}

/* Admin Mode Styles */
.admin-only {
    display: none !important;
}

body.is-admin .admin-only {
    display: inline-block !important;
}

/* Modal Styles */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal.hidden {
    display: none !important;
}

.modal-content {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2rem;
    max-width: 800px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.close-modal {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-size: 2rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s;
}

.close-modal:hover {
    color: white;
}

.modal-img-container {
    width: 100%;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    min-height: 300px;
}

.modal-img-container img {
    max-width: 100%;
    max-height: 50vh;
    object-fit: contain;
}

.modal-3d-container {
    width: 100%;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    height: 50vh;
    min-height: 300px;
    position: relative;
}

.modal-3d-container canvas {
    width: 100% !important;
    height: 100% !important;
    outline: none;
}

.modal-actions {
    display: flex;
    justify-content: center;
}

.btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s ease;
}

.nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(15, 23, 42, 0.8);
    color: white;
    border: 1px solid var(--border-color);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 20;
    transition: all 0.2s;
}
.nav-arrow:hover {
    background: var(--accent-color);
    transform: translateY(-50%);
    box-shadow: none;
}
.nav-arrow.left { left: 0.5rem; }
.nav-arrow.right { right: 0.5rem; }

.loading-dots::after {
    content: ' . . .';
    animation: dots 1.5s steps(4, end) infinite;
}

@keyframes dots {
    0%, 20% { content: ''; }
    40% { content: ' .'; }
    60% { content: ' . .'; }
    80%, 100% { content: ' . . .'; }
}

.btn-primary {
    background: var(--accent-color);
    color: white;
}

.btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
}

.btn-danger {
    background: #ef4444;
    color: white;
    margin-left: 1rem;
    border: none;
    cursor: pointer;
}

.btn-danger:hover {
    background: #dc2626;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
}

.admin-login-btn {
    position: fixed;
    top: 1rem;
    right: 1rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: none;
    cursor: pointer;
    z-index: 1000;
}

.admin-login-btn:hover {
    background: rgba(255, 255, 255, 0.1);
}

body.is-admin .admin-login-btn {
    background: rgba(16, 185, 129, 0.2);
}

.butter-highlight {
    -webkit-text-fill-color: #a855f7;
    color: #a855f7;
    text-shadow: 0 0 20px rgba(168, 85, 247, 0.8), 0 0 40px rgba(168, 85, 247, 0.6);
}

.side-branding {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 200px;
    opacity: 0.07;
    z-index: -1;
    pointer-events: none;
    user-select: none;
}

.side-branding.left {
    left: 2rem;
}

.side-branding.right {
    right: 2rem;
}

@media (max-width: 1300px) {
    .side-branding {
        display: none;
    }
}
</style>
